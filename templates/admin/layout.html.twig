<!DOCTYPE html>
<html lang="fr" data-bs-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Administration{% endblock %} · Navinum</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { background: #f5f6f8; }
        .navbar-brand { font-weight: 600; letter-spacing: .02em; }
        .table td, .table th { vertical-align: middle; }
        .card { border: 0; box-shadow: 0 1px 2px rgba(0,0,0,.06); }
        .placeholder-dash { color: #adb5bd; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
{% block navigation %}
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container-fluid">
        <a class="navbar-brand" href="{{ path('admin_dashboard') }}"><i class="bi bi-compass"></i> Navinum</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav" aria-label="Menu"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="adminNav">
            {% set route = app.request.attributes.get('_route') ?? '' %}
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link {{ route starts with 'admin_exposition_' ? 'active' }}" href="{{ path('admin_exposition_index') }}">Expositions</a></li>
                <li class="nav-item"><a class="nav-link {{ route starts with 'admin_parcours_' ? 'active' }}" href="{{ path('admin_parcours_index') }}">Parcours</a></li>
                {% if is_granted('ROLE_ADMIN') %}
                <li class="nav-item"><a class="nav-link {{ route starts with 'admin_interactif_' ? 'active' }}" href="{{ path('admin_interactif_index') }}">Interactifs</a></li>
                <li class="nav-item"><a class="nav-link {{ route starts with 'admin_visiteur_' ? 'active' }}" href="{{ path('admin_visiteur_index') }}">Visiteurs</a></li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Matériel</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="{{ path('admin_rfid_index') }}">Badges RFID</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_flotte_index') }}">Flottes</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_peripherique_index') }}">Périphériques</a></li>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Gamification</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="{{ path('admin_medaille_index') }}">Médailles</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_typologie_index') }}">Typologies</a></li>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Réglages</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="{{ path('admin_organisateur_index') }}">Organisateurs</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_user_index') }}">Comptes</a></li>
                        <li><a class="dropdown-item" href="{{ path('admin_integration_index') }}">Intégrations</a></li>
                    </ul>
                </li>
                {% endif %}
            </ul>
            {% if app.user %}
            <span class="navbar-text me-3 small"><i class="bi bi-person-circle"></i> {{ app.user }}</span>
            <a class="btn btn-outline-light btn-sm" href="{{ path('app_logout') }}">Déconnexion</a>
            {% endif %}
        </div>
    </div>
</nav>
{% endblock %}

<main class="container-fluid px-4 pb-5">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
