{% extends 'admin/layout.html.twig' %}
{% import 'admin/_macros.html.twig' as m %}
{% block title %}{{ crud.labelPlural }}{% endblock %}
{% block body %}
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0 me-auto">{{ crud.labelPlural }} <span class="text-secondary fs-6">({{ total }})</span></h1>
    {% block actions %}{% endblock %}
    {% if not (crud.readonly ?? false) %}
        <a class="btn btn-primary" href="{{ path(crud.route ~ 'new') }}"><i class="bi bi-plus-lg"></i> Ajouter</a>
    {% endif %}
</div>

{% if crud.search ?? false %}
<form class="mb-3" method="get" role="search">
    <div class="input-group" style="max-width: 420px">
        <input class="form-control" type="search" name="q" value="{{ q }}" placeholder="Rechercher…" aria-label="Rechercher">
        <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
    </div>
</form>
{% endif %}

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    {% for label in crud.columns %}<th scope="col">{{ label }}</th>{% endfor %}
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for item in items %}
                <tr>
                    {% for field, label in crud.columns %}
                        <td>{{ m.value(attribute(item, field)) }}</td>
                    {% endfor %}
                    <td class="text-end text-nowrap">
                        {% block row_actions %}{% endblock %}
                        {% if not (crud.readonly ?? false) %}
                        <a class="btn btn-sm btn-outline-primary" href="{{ path(crud.route ~ 'edit', {id: item.id}) }}" title="Modifier"><i class="bi bi-pencil"></i></a>
                        <form class="d-inline" method="post" action="{{ path(crud.route ~ 'delete', {id: item.id}) }}" onsubmit="return confirm('Supprimer définitivement cet élément ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.id) }}">
                            <button class="btn btn-sm btn-outline-danger" title="Supprimer"><i class="bi bi-trash"></i></button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="{{ crud.columns|length + 1 }}" class="text-center text-secondary py-4">Aucun élément{{ q ? ' pour « ' ~ q ~ ' »' }}.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% if pages > 1 %}
<nav class="mt-3" aria-label="Pagination">
    <ul class="pagination">
        {% for p in 1..pages %}
            <li class="page-item {{ p == page ? 'active' }}"><a class="page-link" href="?{{ {q: q, page: p}|url_encode }}">{{ p }}</a></li>
        {% endfor %}
    </ul>
</nav>
{% endif %}
{% endblock %}
