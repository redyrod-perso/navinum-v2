{
  "libelle": "Quiz multi-joueurs",
  "version": "1.0.0",
  "editeur": "Navinum",
  "description": "Quiz à choix multiples en groupe : un leader choisit le thème, tous les joueurs du groupe répondent aux mêmes questions et les scores s'affichent en temps réel.",
  "source_type": "html5",
  "url": "/quiz/index.html",
  "events": [
    {
      "type": "quiz.started",
      "description": "Le joueur commence une partie. Payload : { theme, nbQuestions, tempsParQuestion, joueurs, groupe }"
    },
    {
      "type": "quiz.answered",
      "description": "Le joueur a répondu à une question (ou le temps est écoulé). Payload : { theme, questionIndex, reponse (index ou null si temps écoulé), correcte, tempsReponse (secondes) }"
    },
    {
      "type": "quiz.completed",
      "description": "Fin de partie pour le joueur. Payload : { theme, score, total, gagnant (pseudo ou null), victoire, joueurs, duree (secondes) }"
    },
    {
      "type": "quiz.abandoned",
      "description": "Le joueur quitte la partie avant la fin. Payload : { theme, score, questionIndex, total }"
    }
  ],
  "configSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Configuration du quiz",
    "type": "object",
    "properties": {
      "tempsParQuestion": {
        "title": "Temps par question (secondes)",
        "description": "Durée maximale pour répondre à une question. Une fois écoulée, la question est comptée fausse. 0 = pas de limite.",
        "type": "integer",
        "minimum": 0,
        "maximum": 300,
        "default": 20
      },
      "nbQuestions": {
        "title": "Nombre de questions par partie",
        "description": "Nombre de questions posées (les premières du thème choisi). Si le thème en contient moins, toutes sont posées.",
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 10
      },
      "joueursMax": {
        "title": "Nombre maximum de joueurs",
        "description": "Nombre maximum de joueurs dans un même groupe (lobby).",
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 8
      },
      "modeBorne": {
        "title": "Mode borne (appareil partagé)",
        "description": "Pour une borne utilisée par plusieurs visiteurs : le joueur est déconnecté à la fin de chaque partie et rien n'est conservé sur l'appareil.",
        "type": "boolean",
        "default": false
      },
      "themes": {
        "title": "Thèmes",
        "description": "Thèmes proposés au leader du groupe, avec leurs questions.",
        "type": "array",
        "minItems": 1,
        "items": {
          "title": "Thème",
          "type": "object",
          "required": [
            "id",
            "libelle",
            "questions"
          ],
          "properties": {
            "id": {
              "title": "Identifiant",
              "description": "Identifiant technique unique (minuscules, chiffres, tirets).",
              "type": "string",
              "pattern": "^[a-z0-9-]+$",
              "minLength": 1
            },
            "libelle": {
              "title": "Libellé",
              "description": "Nom affiché aux joueurs.",
              "type": "string",
              "minLength": 1
            },
            "questions": {
              "title": "Questions",
              "type": "array",
              "minItems": 1,
              "items": {
                "title": "Question",
                "type": "object",
                "required": [
                  "question",
                  "reponses",
                  "correcte"
                ],
                "properties": {
                  "question": {
                    "title": "Intitulé",
                    "type": "string",
                    "minLength": 1
                  },
                  "reponses": {
                    "title": "Réponses proposées",
                    "description": "Exactement 4 réponses.",
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "title": "Réponse",
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "correcte": {
                    "title": "Bonne réponse",
                    "description": "Numéro de la bonne réponse (0 = première, 3 = quatrième).",
                    "type": "integer",
                    "enum": [
                      0,
                      1,
                      2,
                      3
                    ],
                    "default": 0
                  }
                }
              }
            }
          }
        },
        "default": [
          {
            "id": "histoire",
            "libelle": "Histoire",
            "questions": [
              {
                "question": "En quelle année a eu lieu la Révolution française ?",
